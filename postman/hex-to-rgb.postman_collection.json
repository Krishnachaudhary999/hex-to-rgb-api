{
  "info": {
    "name": "hex-to-rgb-api",
    "description": "Manual verification of the hex-to-RGB REST API. Every request carries assertions, so the Collection Runner reports a pass/fail summary. Set the baseUrl variable if the server does not run on port 3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1 Health check - 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('status field is ok', function () {",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Valid 6-digit hex - 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/convert?hex=FF8800",
          "host": ["{{baseUrl}}"],
          "path": ["api", "convert"],
          "query": [{ "key": "hex", "value": "FF8800" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('content type is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('channels are correct', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.r).to.eql(255);",
              "    pm.expect(body.g).to.eql(136);",
              "    pm.expect(body.b).to.eql(0);",
              "});",
              "pm.test('css string is formatted correctly', function () {",
              "    pm.expect(pm.response.json().css).to.eql('rgb(255, 136, 0)');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Valid hex with encoded hash - 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/convert?hex=%23FF8800",
          "host": ["{{baseUrl}}"],
          "path": ["api", "convert"],
          "query": [{ "key": "hex", "value": "%23FF8800" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('encoded # is decoded and echoed in input', function () {",
              "    pm.expect(pm.response.json().input).to.eql('#FF8800');",
              "});",
              "pm.test('result matches the bare form', function () {",
              "    pm.expect(pm.response.json().css).to.eql('rgb(255, 136, 0)');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Valid 3-digit shorthand - 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/convert?hex=f80",
          "host": ["{{baseUrl}}"],
          "path": ["api", "convert"],
          "query": [{ "key": "hex", "value": "f80" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('shorthand expands to the same colour as #ff8800', function () {",
              "    pm.expect(pm.response.json().css).to.eql('rgb(255, 136, 0)');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Missing hex parameter - 400",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": ["{{baseUrl}}"],
          "path": ["api", "convert"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('error names the required parameter', function () {",
              "    pm.expect(pm.response.json().error).to.eql(\"Query parameter 'hex' is required\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Invalid hex value - 400",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/convert?hex=gg0000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "convert"],
          "query": [{ "key": "hex", "value": "gg0000" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('error echoes the rejected value', function () {",
              "    pm.expect(pm.response.json().error).to.eql(\"Invalid hex colour: 'gg0000'\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Unknown route - 404",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["api", "does-not-exist"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('404 body is JSON with an error field', function () {",
              "    pm.expect(pm.response.json().error).to.eql('Not found');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
